<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".EditSessionActivity">

    <TextView
        android:id="@+id/tvFormTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/form_title"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:layout_marginBottom="24dp"/>

    <EditText
        android:id="@+id/etMovieTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_movie_title"
        android:inputType="text"
        android:importantForAutofill="no"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etHallName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_hall_name"
        android:inputType="text"
        android:importantForAutofill="no"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etDateTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_date_time"
        android:inputType="date"
        android:importantForAutofill="no"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etTicketPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_ticket_price"
        android:inputType="numberDecimal"
        android:importantForAutofill="no"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etDuration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_duration"
        android:inputType="number"
        android:importantForAutofill="no"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_description"
        android:inputType="textMultiLine"
        android:lines="3"
        android:gravity="top"
        android:importantForAutofill="no"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_save_session"
        android:textSize="16sp"/>

</LinearLayout>